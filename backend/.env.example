PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-hostinger-domain.com
JWT_SECRET=change-this-before-deployment

MYSQLHOST=your-hostinger-mysql-host
MYSQLPORT=3306
MYSQLUSER=your-hostinger-mysql-user
MYSQLPASSWORD=your-hostinger-mysql-password
MYSQLDATABASE=your-hostinger-mysql-database
# Alternative Hostinger-style variable names are also supported:
# DB_HOST=your-hostinger-mysql-host
# DB_PORT=3306
# DB_USER=your-hostinger-mysql-user
# DB_PASSWORD=your-hostinger-mysql-password
# DB_NAME=your-hostinger-mysql-database

# If Hostinger only offers Supabase, use this instead of the MySQL variables:
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database

ADMIN_EMAIL=LKMALLSHOP@GMAIL.COM
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=HOI Admin

REQUIRE_EMAIL_MX_CHECK=false

REQUIREMENT_EMAIL=team@example.com
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
