PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-before-deployment

DB_CLIENT=mysql
DATABASE_URL=mysql://hoi_user:hoi_password@127.0.0.1:3307/hoi_business_center
# Railway MySQL can also provide MYSQL_URL. The backend accepts either DATABASE_URL or MYSQL_URL.
REQUIRE_EMAIL_MX_CHECK=false

# Mail notifications
REQUIREMENT_EMAIL=LKMALLSHOP@GMAIL.COM
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Optional phone OTP SMS provider. Configure one for real phone delivery.
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
