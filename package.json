{
  "name": "kil-hoi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "body-parser": "1.20.6",
      "brace-expansion": "5.0.8",
      "esbuild": "0.28.1"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "build": "node scripts/fix-esbuild-permissions.mjs && vite build",
    "start": "node app.js",
    "init-db": "node backend/scripts/init-db.js",
    "db:init": "node backend/scripts/init-db.js",
    "test:api": "node scripts/test-api.mjs",
    "ci": "npm run lint && npm run build && npm run test:api",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{src,*.json,*.md}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.6",
    "bcryptjs": "^2.4.3",
    "body-parser": "2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.14.0",
    "multer": "^2.2.0",
    "mysql2": "^3.14.3",
    "nodemailer": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "wouter": "^3.3.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.22",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3"
  }
}
